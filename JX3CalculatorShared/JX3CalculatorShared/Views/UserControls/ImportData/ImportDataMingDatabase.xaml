<UserControl
    x:Class="JX3CalculatorShared.Views.UserControls.ImportDataMingDatabase"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mi="clr-namespace:MingYiTools"
    xmlns:uc="clr-namespace:JX3CalculatorShared.Views.UserControls"
    xmlns:views="clr-namespace:JX3CalculatorShared.Views"
    xmlns:globals="clr-namespace:JX3PZ.Globals"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- MingYiServerInfo 下拉项模板 -->
            <DataTemplate x:Key="MingYiServerInfoItemTemplate" DataType="{x:Type mi:MingYiServerInfo}">
                <StackPanel Margin="2" Width="120">
                    <TextBlock Text="{Binding ServerName}" FontWeight="Bold" FontSize="16" Margin="0 2" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding OwnerCount, StringFormat='{}角色数:{0}'}" Foreground="Gray" FontSize="14"/>
                </StackPanel>
            </DataTemplate>

            <!-- MingYiOwnerInfoItem 下拉项模板 -->
            <DataTemplate x:Key="MingYiOwnerInfoItemTemplate" DataType="{x:Type mi:MingYiOwnerInfoEntity}">
                <Grid Margin="2" Width="230">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Image Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Source="pack://application:,,,/Resource/Images/jy_player_avatar.png"
                           Width="40" Height="40" Margin="0 0 5 0"/>

                    <DockPanel Grid.Row="0" Grid.Column="1">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding OwnerName}" FontWeight="Bold" Foreground="#4b7128" FontSize="16" VerticalAlignment="Center" Margin="0 2"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding OwnerLevel, StringFormat='等级{0}'}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <DockPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock DockPanel.Dock="Left" Text="快照时间" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding LastTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="Gray" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                </Grid>
            </DataTemplate>

            <!-- 简化的套装下拉项模板（参照 MingYiOwnerInfoItemTemplate） -->
            <DataTemplate x:Key="MingYiOwnerSuitTemplate">
                <StackPanel Orientation="Vertical" Width="160">
                    <TextBlock Text="{Binding SuitIndex, StringFormat='{}第 {0} 套装备'}" FontSize="14"/>
                    <TextBlock Text="{Binding Score, StringFormat='{}装备分数 {0}'}" FontSize="14"/>
                </StackPanel>
            </DataTemplate>

            <views:RichTextSegmentsToDocumentConverter x:Key="SegmentsToDocConverter"/>
            <Style x:Key="RichTextToolTipStyle" TargetType="ToolTip">
                <Setter Property="Background" Value="{x:Static globals:ColorConst.EquipBackgroundBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="6"/>
                <Setter Property="HasDropShadow" Value="False"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="4">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="MingYiEquipItemTemplate">
                <TextBlock TextTrimming="None" MinWidth="160" TextWrapping="NoWrap" FontSize="14"
                           DataContext="{Binding ViewModel}" Margin="4 2">
                    <Run Text="{Binding PositionLabel, StringFormat='{}{0}：'}"  Foreground="Black"/>
                    <Run Text="{Binding NameLabel}" Foreground="{Binding NameColor, TargetNullValue=Black, FallbackValue=Black}" FontWeight="Bold"/>
                    <Run Text="{Binding StrengthLabel}" Foreground="Black"/>

                    <TextBlock.ToolTip>
                        <ToolTip Style="{StaticResource RichTextToolTipStyle}" Visibility="{Binding IsValidEquip, Converter={StaticResource BooleanToVisibility}}">
                            <uc:RichTextBoxExt DocumentSource="{Binding DescRichTextSegments, Converter={StaticResource SegmentsToDocConverter}}"
                                               MaxWidth="350"
                                               Background="Transparent" 
                                               BorderThickness="0" 
                                               IsReadOnly="True" 
                                               IsHitTestVisible="False" 
                                               Focusable="False" />
                        </ToolTip>
                    </TextBlock.ToolTip>

                </TextBlock>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" HorizontalAlignment="Stretch" Margin="5">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <TextBox hc:InfoElement.Title="客户端zhcn_hd目录" hc:InfoElement.TitlePlacement="Left" Style="{StaticResource TextBoxExtend}" Text="{Binding JX3Folder, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Width="450" Margin="5" />
                <Button Command="{Binding SelectFolderCmd}" Content="选择目录" Margin="5"/>
                <Button x:Name="LoadDatabaseBtn" Command="{Binding LoadDatabaseCmd}" Content="加载数据" Margin="5" Style="{StaticResource ButtonSuccess}"/>
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5 3">

            <ComboBox x:Name="MingYiServerInfoComboBox" Margin="5" Width="200"
                      SelectedItem="{Binding SelectedMingYiServerInfo}"
                      SelectedIndex="{Binding SelectedMingYiServerInfoIndex}"
                      ItemsSource="{Binding MingYiServerInfoList}"
                      hc:InfoElement.TitlePlacement="Top" hc:InfoElement.Title="区服"
                      Style="{StaticResource ComboBoxExtend}"
                      ItemTemplate="{StaticResource MingYiServerInfoItemTemplate}"/>

            <ComboBox x:Name="MingYiOwnerInfoComboBox" Margin="10 5"
                      SelectedItem="{Binding SelectedMingYiOwnerInfoEntity}"
                      SelectedIndex="{Binding SelectedMingYiOwnerInfoIndex}"
                      ItemsSource="{Binding CurrentServerMingYiOwnerInfoList}" Width="290"
                      hc:InfoElement.TitlePlacement="Top" hc:InfoElement.Title="角色"
                      Style="{StaticResource ComboBoxExtend}"
                      ItemTemplate="{StaticResource MingYiOwnerInfoItemTemplate}"/>
        </StackPanel>

        <GroupBox Grid.Row="2" Header="装备详情" Style="{x:Null}" Margin="5" Visibility="{Binding IsCurrentOwnerEquipLoaded, Converter={StaticResource Boolean2VisibilityConverter}}">
            <!-- 用 Grid 替代 StackPanel，使右侧区域能在垂直方向被约束，从而启用滚动 -->
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="CurrentMingYiOwnerSuitListView"
                         ItemsSource="{Binding MingYiOwnerSuitList}"
                         SelectedItem="{Binding SelectedMingYiOwnerSuit}"
                         SelectedIndex="{Binding SelectedSuitIndex}"
                         ItemTemplate="{StaticResource MingYiOwnerSuitTemplate}"
                         Grid.Column="0"
                         VerticalAlignment="Stretch"/>

                <Border Grid.Column="2" VerticalAlignment="Stretch" BorderBrush="LightGray" BorderThickness="1">
                    <!-- ScrollViewer 设置为 Auto，当内容高度超过可用高度时显示竖向滚动条 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Stretch">
                        <ItemsControl x:Name="SelectedMingYiOwnerSuitDetailListView"
                                      ItemsSource="{Binding SelectedMingYiOwnerSuit.ValidEquipItems}"
                                      Style="{x:Null}"
                                      ItemTemplate="{StaticResource MingYiEquipItemTemplate}"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </GroupBox>

        <Button Grid.Row="3" Command="{Binding ImportCmd}" VerticalAlignment="Bottom" Margin="7" 
                HorizontalAlignment="Right" Content="导入" Style="{StaticResource ButtonPrimary}"
                Width="100" Height="30" />
    </Grid>
</UserControl>
        