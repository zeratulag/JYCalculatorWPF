<UserControl x:Class="JX3PZ.Views.BuildCompare.PzBuildCompareSlotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sf="http://schemas.syncfusion.com/wpf"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:buildCompare="clr-namespace:JX3PZ.Views.BuildCompare"
             xmlns:utils="clr-namespace:JX3CalculatorShared.Utils">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="BuildComparePanelBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BuildCompareBorderBrush" Color="#D7E0EA" />
            <SolidColorBrush x:Key="BuildCompareMutedBrush" Color="#6B7785" />
            <SolidColorBrush x:Key="BuildComparePrimaryBrush" Color="#2F6FED" />
            <SolidColorBrush x:Key="BuildCompareProgressBrush" Color="#2DB84D" />
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="12 0 0 0">
        <Border DockPanel.Dock="Top"
                Padding="0 0 0 10"
                Background="Transparent"
                BorderBrush="{StaticResource BuildCompareBorderBrush}"
                BorderThickness="0 0 0 1"
                Margin="0 0 0 10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0 0 24 0" 
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="计算进度"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource BuildCompareMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <DockPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="12 0 0 0">
                        <TextBlock Text="{Binding Completed, Mode=OneWay}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text=" / " VerticalAlignment="Center"
                                   Foreground="{StaticResource BuildCompareMutedBrush}" />
                        <TextBlock Text="{Binding Total, Mode=OneWay}" VerticalAlignment="Center"
                                   Foreground="{StaticResource BuildCompareMutedBrush}" />
                    </StackPanel>
                    <ProgressBar x:Name="CalcProgressBar" Height="14"
                                 Minimum="0"
                                 Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                                 Value="{Binding Completed, Mode=OneWay}"
                                 Foreground="{StaticResource BuildCompareProgressBrush}"
                                 Background="#E9EEF5" />
                </DockPanel>

                <Button Grid.Column="2"
                        Content="替换装备"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding SetCurrentEquipCmd}"
                        Height="30"
                        Margin="22 0 0 0"
                        Padding="14 0"
                        VerticalAlignment="Center" />

                <StackPanel Grid.Column="3" Margin="22 0 0 0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="计算耗时" FontSize="12" Foreground="{StaticResource BuildCompareMutedBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ElapsedText}"
                               FontSize="12"
                               Margin="0 2 0 0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Background="{StaticResource BuildComparePanelBrush}"
                BorderBrush="{StaticResource BuildCompareBorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <sf:SfDataGrid AutoGenerateColumns="False"
                           AllowSorting="True"
                           AllowResizingColumns="True"
                           AllowFiltering="True"
                           ColumnSizer="Star"
                           HeaderRowHeight="36"
                           RowHeight="32"
                           ItemsSource="{Binding Items}"
                           GridLinesVisibility="Horizontal"
                           HeaderLinesVisibility="Horizontal"
                           SelectionMode="Single"
                           SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                           NavigationMode="Row"
                           IsReadOnly="True"
                           BorderThickness="0"
                           Background="{StaticResource BuildComparePanelBrush}">
            <sf:SfDataGrid.Columns>
                <sf:GridTemplateColumn HeaderText="装备" MappingName="Name" MinimumWidth="180">
                    <sf:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4 0 0 0"
                                        Style="{StaticResource Style.ToolTipEquipShowControl}"
                                        ToolTipService.IsEnabled="{Binding HasEquipShow}">
                                <Border Style="{StaticResource Style.ItemExternalBorder}"
                                        Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibility}}">
                                    <Border Style="{StaticResource Style.ItemInternalBorder}">
                                        <Image Width="24" Height="24">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Source" Value="{x:Null}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                            <Setter Property="Source"
                                                                    Value="{Binding IconID, Converter={StaticResource IconIDToImgConverter}}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Border>
                                </Border>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="8 0 0 0"
                                           Foreground="{Binding Quality, Converter={StaticResource QualityToColorConverter}}" />
                                <TextBlock Text="当前" VerticalAlignment="Center" Margin="6 0 0 0"
                                           Foreground="White" FontSize="12"
                                           Background="#1976D2" Padding="4 2"
                                           Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </sf:GridTemplateColumn.CellTemplate>
                </sf:GridTemplateColumn>
                <sf:GridTextColumn MappingName="LevelText"
                                   HeaderText="品级"
                                   MinimumWidth="70"
                                   HorizontalHeaderContentAlignment="Center"
                                   TextAlignment="Center" />
                <sf:GridTextColumn MappingName="AttributeDesc"
                                   HeaderText="属性"
                                   MinimumWidth="160"
                                   HorizontalHeaderContentAlignment="Center" />
                <sf:GridTemplateColumn MappingName="Dps" HeaderText="DPS" MinimumWidth="95">
                    <sf:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Dps, StringFormat={}{0:F0}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasValue}" Value="False">
                                                <Setter Property="Text" Value="-" />
                                                <Setter Property="Foreground" Value="Gray" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </sf:GridTemplateColumn.CellTemplate>
                </sf:GridTemplateColumn>
                <sf:GridTemplateColumn HeaderText="差异" MappingName="DeltaDps" MinimumWidth="95">
                    <sf:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding DeltaDps, StringFormat={x:Static utils:DeltaDisplayTool.PointStringFormat}}" />
                                        <Setter Property="Foreground" Value="{Binding DeltaDpsColor}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasValue}" Value="False">
                                                <Setter Property="Text" Value="-" />
                                                <Setter Property="Foreground" Value="Gray" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </sf:GridTemplateColumn.CellTemplate>
                </sf:GridTemplateColumn>
                <sf:GridTemplateColumn HeaderText="相对差异" MappingName="DeltaDpsPct" MinimumWidth="140">
                    <sf:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <buildCompare:RelativeDeltaBarCell />
                        </DataTemplate>
                    </sf:GridTemplateColumn.CellTemplate>
                </sf:GridTemplateColumn>
                <sf:GridTemplateColumn HeaderText="#"
                                       MappingName="Rank"
                                       MinimumWidth="46"
                                       HorizontalHeaderContentAlignment="Center">
                    <sf:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RankText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </sf:GridTemplateColumn.CellTemplate>
                </sf:GridTemplateColumn>
                <sf:GridTextColumn MappingName="Status"
                                   HeaderText="状态"
                                   MinimumWidth="74"
                                   TextAlignment="Center">
                    <sf:GridTextColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding StatusColor}" FontWeight="Bold" />
                        </DataTemplate>
                    </sf:GridTextColumn.CellTemplate>
                </sf:GridTextColumn>
            </sf:SfDataGrid.Columns>
            </sf:SfDataGrid>
        </Border>
    </DockPanel>
</UserControl>
