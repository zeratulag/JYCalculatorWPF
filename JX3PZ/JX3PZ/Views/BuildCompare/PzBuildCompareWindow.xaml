<Window x:Class="JX3PZ.Views.BuildCompare.PzBuildCompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:buildCompare="clr-namespace:JX3PZ.Views.BuildCompare"
        Title="{Binding Title}"
        Height="800"
        Width="1200"
        MinHeight="620"
        MinWidth="1080"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        Background="#F4F7FB"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
                <ResourceDictionary Source="/Views/Resources/PzApp.xaml" />
                <ResourceDictionary Source="/Views/Resources/Converters.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="BuildComparePanelBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BuildCompareRailBrush" Color="#EDF3FA" />
            <SolidColorBrush x:Key="BuildCompareHoverBrush" Color="#F7FAFE" />
            <SolidColorBrush x:Key="BuildCompareBorderBrush" Color="#D7E0EA" />
            <SolidColorBrush x:Key="BuildCompareMutedBrush" Color="#6B7785" />
            <SolidColorBrush x:Key="BuildComparePrimaryBrush" Color="#2F6FED" />
            <SolidColorBrush x:Key="BuildCompareProgressBrush" Color="#2DB84D" />

            <Style x:Key="BuildCompareToolbarButton" TargetType="{x:Type Button}">
                <Setter Property="Height" Value="30" />
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="Padding" Value="12 0" />
                <Setter Property="Foreground" Value="#2E3A46" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="{StaticResource BuildCompareBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#F7FAFE" />
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B9C8DA" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#EDF3FA" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2 0 2 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="110 3 0 0">
                <TextBlock Text="基准 DPS"
                           FontSize="12"
                           Foreground="{StaticResource BuildCompareMutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding SelectedSlot.BaseDps, StringFormat={}{0:F0}}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="20 0 0 0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <hc:UniformSpacingPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="20"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource ButtonWarning}"
                        Command="{Binding CalcAllSlotsCmd}" Content="全部计算" />
                <Button Command="{Binding ExportCurrentSlotReportCmd}"
                        Style="{StaticResource BuildCompareToolbarButton}"
                        ToolTip="导出当前装备栏的对比报告为 XLSX 文件"
                        >
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Resource/Images/Excel.png"
                               Width="16"
                               Height="16"
                               Margin="0 0 6 0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="导出当前结果"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportAllSlotReportsCmd}"
                        Style="{StaticResource ButtonPrimary}"
                        ToolTip="导出所有装备栏的对比报告为 XLSX 文件">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Resource/Images/Excel.png"
                               Width="16"
                               Height="16"
                               Margin="0 0 6 0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="导出全部结果"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </hc:UniformSpacingPanel>
        </Grid>

        <TabControl ItemsSource="{Binding Slots}"
                    Grid.Row="1"
                    Style="{StaticResource TabControlSliding}"
                    TabStripPlacement="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    SelectedItem="{Binding SelectedSlot, Mode=TwoWay}">
            <TabControl.ItemContainerStyle>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Width" Value="90" />

                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabItem}">
                                <Border x:Name="TabItemBorder"
                                        Background="{StaticResource BuildCompareRailBrush}"
                                        BorderBrush="{StaticResource BuildCompareBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="3">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabItemBorder" Property="Background"
                                                Value="{StaticResource BuildCompareHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabItemBorder" Property="Background"
                                                Value="{StaticResource BuildComparePanelBrush}" />
                                        <Setter TargetName="TabItemBorder" Property="BorderBrush"
                                                Value="{StaticResource BuildComparePrimaryBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.ItemContainerStyle>
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <Grid VerticalAlignment="Center" Margin="10 0 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <hc:CircleProgressBar x:Name="CalcCircleProgressBar"
                                              Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                              Width="20"
                                              Height="20"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Minimum="0"
                                              Maximum="100"
                                              Value="{Binding ProgressPercent, Mode=OneWay}"
                                              ShowText="False"
                                              ArcThickness="4"
                                              FontWeight="SemiBold"
                                              Style="{StaticResource ProgressBarInfoCircle}"
                                              Foreground="{StaticResource BuildCompareProgressBrush}"
                                              BorderBrush="#DCE6F2" />

                        <TextBlock Text="{Binding Header}" Grid.Column="1" Grid.Row="0" VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusText}" Grid.Column="1" Grid.Row="1" VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{Binding StatusColor}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate>
                    <buildCompare:PzBuildCompareSlotView />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</Window>