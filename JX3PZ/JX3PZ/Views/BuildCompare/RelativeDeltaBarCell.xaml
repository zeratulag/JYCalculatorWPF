<UserControl x:Class="JX3PZ.Views.BuildCompare.RelativeDeltaBarCell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utils="clr-namespace:JX3CalculatorShared.Utils"
             ClipToBounds="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <LinearGradientBrush x:Key="PositiveBarBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#5DBB73" Offset="0" />
            <GradientStop Color="#DDF2E5" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NegativeBarBrush" StartPoint="1,0.5" EndPoint="0,0.5">
            <GradientStop Color="#D96A5E" Offset="0" />
            <GradientStop Color="#F8D9D5" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid Margin="6 0" ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="60" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0"
              Margin="0 0 8 0"
              ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding RelativeDeltaBar.NegativeAxisWidth}" />
                <ColumnDefinition Width="{Binding RelativeDeltaBar.PositiveAxisWidth}" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Name="NegativeRelativeDeltaBarGrid"
                  Height="13"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding RelativeDeltaBar.NegativeEmptyWidth}" />
                    <ColumnDefinition Width="{Binding RelativeDeltaBar.NegativeBarWidth}" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="1"
                        BorderBrush="#D96A5E"
                        BorderThickness="1"
                        Background="{StaticResource NegativeBarBrush}"
                        Opacity="0.55"
                        Visibility="{Binding RelativeDeltaBar.HasNegativeBar, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>

            <Grid Grid.Column="1"
                  Height="{Binding ElementName=NegativeRelativeDeltaBarGrid, Path=Height}"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding RelativeDeltaBar.PositiveBarWidth}" />
                    <ColumnDefinition Width="{Binding RelativeDeltaBar.PositiveEmptyWidth}" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        BorderBrush="#5DBB73"
                        BorderThickness="1"
                        Background="{StaticResource PositiveBarBrush}"
                        Opacity="0.55"
                        Visibility="{Binding RelativeDeltaBar.HasPositiveBar, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>

            <Line Grid.Column="0"
                  X1="0"
                  X2="0"
                  Y1="0"
                  Y2="1"
                  Stretch="Fill"
                  Stroke="#66000000"
                  StrokeThickness="1"
                  StrokeDashArray="2 2"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Stretch"
                  Visibility="{Binding RelativeDeltaBar.HasAxis, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <TextBlock Grid.Column="1"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text">
                        <Setter.Value>
                            <Binding Path="DeltaDpsPct" StringFormat="{x:Static utils:DeltaDisplayTool.PercentStringFormat}" />
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="{Binding DeltaDpsPctColor}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasValue}" Value="False">
                            <Setter Property="Text" Value="-" />
                            <Setter Property="Foreground" Value="Gray" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
